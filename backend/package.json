{
  "name": "stockroom-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Auth and product services for Stockroom",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev:auth & npm run dev:product & wait",
    "dev:auth": "tsx watch services/auth/src/server.ts",
    "dev:product": "tsx watch services/product/src/server.ts",
    "build": "node esbuild.config.js",
    "start:auth": "node dist/auth.js",
    "start:product": "node dist/product.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write services tests db",
    "test": "jest",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^29.7.0",
    "prettier": "^3.10.1",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
