DATABASE_URL=postgres://stockroom:stockroom@localhost:5432/stockroom
DB_SSL=false

# Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=86400

CORS_ORIGIN=http://localhost:3000
AUTH_PORT=4001
PRODUCT_PORT=4002

# Password given to the demo users created by `npm run db:seed`
SEED_USER_PASSWORD=ChangeMe@123
